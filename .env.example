# Copy to .env.local (git-ignored) and fill in from Firebase console → Project settings → Your apps (Web).
# These are PUBLIC web identifiers, not secrets — but never commit .env.local anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check — reCAPTCHA Enterprise site key (Firebase console → App Check → Apps).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# App Check debug token for localhost (Firebase console → App Check → Manage debug tokens).
# Leave empty to have the SDK print a fresh token in the browser console on first run.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional: override the cloud model (defaults to the SDK's hybrid default).
VITE_CLOUD_MODEL=
