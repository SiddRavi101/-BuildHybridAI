rules_version = '2';
// Each anonymous user can only read/write their own incidents.
// De-identified records are the default; identifiable records require an explicit
// per-incident opt-in in the app and are flagged containsPHI == true.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/incidents/{incidentId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.ownerUid == uid
        && request.resource.data.containsPHI is bool;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
